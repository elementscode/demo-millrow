import "./style.css";
import { OrderDetail, carrierUrl } from "#app/shared/services/orders";
import { OrderLines, ShipTo } from "#app/emails/shared";

/**
 * Sent when the owner marks the order shipped with a tracking number.
 *
 * @email
 */
<html (detail: OrderDetail)>
  <body class="email order-shipped">
    <div class="email-wrap">
      <p class="brand">Millrow Coffee</p>
      <h1>Order #{detail.order.number} is on its way</h1>
      <p>Your coffee left the roastery today.</p>

      <div class="panel">
        <strong>{detail.order.carrier} tracking</strong><br>
        <a href={carrierUrl(detail.order.carrier, detail.order.trackingNumber)}>{detail.order.trackingNumber}</a>
      </div>

      <OrderLines {detail} />
      <ShipTo {detail} />

      <p><a class="button" href={`/order/${detail.order.id}`}>View your order</a></p>

      <div class="email-footer">
        <p>Millrow Coffee · Questions? Reply to this email.</p>
      </div>
    </div>
  </body>
</html>
