import "./style.css";
import { redirect } from "@elements/app";
import { signout } from "#app/shared/services/auth";

function onSignout() {
  signout();
  redirect("/signin");
}

<AdminLayout (section: string)>
  <div class="app has-sidebar admin">
    <aside class="admin-side">
      <a href="/admin" class="admin-brand row">
        <svg viewBox="0 0 32 32" width="24" height="24" aria-hidden="true" focusable="false">
          <circle cx="16" cy="16" r="15" fill="currentColor"/>
          <path d="M16 5 C10 10 10 22 16 27 C22 22 22 10 16 5 Z" fill="none" stroke="#fff" stroke-width="2"/>
          <path d="M16 6 C13 12 19 20 16 26" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Millrow <small>admin</small>
      </a>

      <nav class="admin-nav stack" aria-label="Admin">
        <a href="/admin" class={[section === "dashboard" && "is-active"]}>Dashboard</a>
        <a href="/admin/orders" class={[section === "orders" && "is-active"]}>Orders</a>
        <a href="/admin/products" class={[section === "products" && "is-active"]}>Products</a>
      </nav>

      <div class="admin-foot stack">
        <a href="/" target="_blank" rel="noopener">View the shop ↗</a>
        <a href="#" onclick={() => onSignout()}>Sign out</a>
      </div>
    </aside>

    <main class="app-main admin-main">
      <div class="admin-content stack is-xl">
        <slot/>
      </div>
    </main>
  </div>
</AdminLayout>
